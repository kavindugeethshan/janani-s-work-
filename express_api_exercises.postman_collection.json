    {
      "name": "Exercise 4: Library Book Search with Query Params",
      "item": [
        {
          "name": "1. GET All Library Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "2. GET Books Filtered by Category (Programming)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?category=Programming",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "category",
                  "value": "Programming"
                }
              ]
            }
          }
        },
        {
          "name": "3. GET Single Book by ID (2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "2"]
            }
          }
        },
        {
          "name": "4. POST Add New Library Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native Architectures\",\n  \"category\": \"Cloud Computing\",\n  \"available\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        }
      ]
